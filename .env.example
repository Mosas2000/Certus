# ─────────────────────────────────────────────────────────────────────────────
# Certus environment
# Copy to .env and fill in. NEVER commit .env or any private key.
# Testnet tokens: STT gas + tUSDC collateral.
#   https://testnet.somnia.network (STT faucet)
#   SomniaHacks dev group faucet topic for tUSDC: https://t.me/+XHq0F0JXMyhmMzM0
# ─────────────────────────────────────────────────────────────────────────────

# ── Keys ─────────────────────────────────────────────────────────────────────
# Operator key used by scripts/doctor.ts and the engine's shared reads/writes.
# A funded Shannon testnet key (STT for gas, tUSDC for collateral).
PRIVATE_KEY=0x...

# One funded key per trading agent (Phase 2+). Generate with:
#   pnpm run agents:setup
# (shipped by the Phase 2 issue) or any keygen you trust, then fund each of them.
AGENT_MOMENTUM_PRIVATE_KEY=
AGENT_MEANREV_PRIVATE_KEY=
AGENT_MAKER_PRIVATE_KEY=
AGENT_CHIMP_PRIVATE_KEY=
AGENT_LLM_PRIVATE_KEY=

# Anthropic API key for the LLM agent's reasoning (Phase 4).
# OPTIONAL: when absent the LLM agent falls back to a rule-based reasoner and
# the app must keep working end to end.
ANTHROPIC_API_KEY=
# OPTIONAL: model for the LLM agent (default claude-sonnet-4-5).
ANTHROPIC_MODEL=

# ── Network (Somnia Shannon testnet, chain 50312) ───────────────────────────
# Defaults below are the public endpoints published by the DreamDEX bot-kit
# and the hackathon starter template. Override only if you run your own.
NETWORK=testnet
RPC_URL=https://dream-rpc.somnia.network
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
# Indexer (GraphQL) — required at SDK construction.
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# DreamDEX event-contract venue id. Markets from several venues sit side by
# side in the indexer; Certus always filters by venueId (hard constraint 8).
# This value MOVES when the venue is redeployed: if the engine reports no
# markets, read the venueId off a live market row (doctor prints it) and set
# it here.
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# ── Engine ───────────────────────────────────────────────────────────────────
# ALL bots default to dry-run. Flip to false only on a funded key, on testnet,
# after the Phase 2 DRY_RUN gate has passed. (hard constraint 12)
DRY_RUN=true
# SQLite database file. The engine writes it; apps/web reads it server-side.
# Relative paths resolve against the repo root.
DB_PATH=data/certus.sqlite
# Market poll interval for the Phase 1 indexer loop, in ms.
POLL_INTERVAL_MS=30000
# How many recently Finalized markets the redemption sweeper scans per pass.
CLAIM_SCAN=20
# How often the sweeper runs, in ms.
SWEEP_INTERVAL_MS=600000

# ── Agents (Phase 2 trading knobs) ───────────────────────────────────────────
# Per-market net position cap, in whole outcome contracts, shared by all agents.
AGENT_POSITION_CAP=20
# Taker order size, in whole outcome contracts (momentum + mean-reversion).
AGENT_TAKE_SIZE=2
# Momentum: Up-probability drift over the lookback window that triggers a take.
MOMENTUM_DRIFT=0.05
# Mean-reversion: deviation from the window's opening implied probability that
# triggers a fade, and the band inside which a held position is flattened.
MEANREV_DEVIATION=0.08
MEANREV_EXIT_BAND=0.03
# Market maker: half-spread around the mid and quote size per side, in
# probability / whole contracts.
MM_SPREAD=0.03
MM_QUOTE_SIZE=3
# Chimp: per-tick trade probability and max size in whole contracts.
CHIMP_PROB=0.15
CHIMP_MAX_SIZE=3

# ── Web arena (apps/web) ────────────────────────────────────────────────────
# NEXT_PUBLIC_* values are exposed to the browser: read-only market data only.
# NEVER put a private key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://dream-rpc.somnia.network
NEXT_PUBLIC_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
NEXT_PUBLIC_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
NEXT_PUBLIC_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
NEXT_PUBLIC_EXPLORER_URL=https://shannon-explorer.somnia.network
